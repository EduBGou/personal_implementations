{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "C++: Build all cpp files in folder",
            "command": "& 'C:/DevTools/msys64/ucrt64/bin/g++.exe' -fdiagnostics-color=always -g -O0 -std=c++20 (Get-ChildItem -Path '${fileDirname}' -Filter *.cpp | ForEach-Object { $_.FullName }) '${workspaceFolder}\\src\\utils\\utils.cpp' -o '${fileDirname}\\${fileDirnameBasename}.exe'",
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "type": "shell",
            "label": "C++: Run current folder .exe",
            "command": "& '${fileDirname}\\${fileDirnameBasename}.exe'",
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [],
            "dependsOn": "C++: Build all cpp files in folder",
            "dependsOrder": "sequence"
        }
    ]
}