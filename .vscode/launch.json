{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C++: Debug current file",
            "type": "cppdbg",
            "request": "launch",

            "program": "${fileDirname}\\${fileDirnameBasename}.exe",

            "args": [],

            "stopAtEntry": false,

            "cwd": "${workspaceFolder}",

            "environment": [],

            "externalConsole": false,

            "MIMode": "gdb",

            "miDebuggerPath": "C:/DevTools/msys64/ucrt64/bin/gdb.exe",

            "preLaunchTask": "C++: Build all cpp files in folder",

            "setupCommands": [
                {
                    "description": "Enable GDB pretty printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}

